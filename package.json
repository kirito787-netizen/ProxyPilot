{
  "name": "proxypilot-desktop",
  "version": "1.0.0",
  "description": "ProxyPilot — Windows desktop proxy switcher with per-domain system PAC routing",
  "license": "MIT",
  "main": "desktop/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win",
    "test:pac": "node desktop/pac-test.mjs",
    "test:chrome": "node desktop/chrome-pac-test.mjs",
    "test:exe": "node tools/qa/exe-pac-e2e.mjs",
    "test:web": "node tools/qa/web-extension-test.mjs",
    "test:settings": "node tools/verify-settings.mjs",
    "build:slim": "node tools/build-slim.mjs",
    "sync:web": "node tools/sync-web.mjs"
  },
  "build": {
    "appId": "local.proxypilot.desktop",
    "productName": "ProxyPilot",
    "files": [
      "app/**/*",
      "desktop/**/*",
      "icons/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "rcedit": "^5.0.2"
  }
}

{
  "name": "proxypilot-desktop",
  "version": "1.0.0",
  "description": "ProxyPilot desktop system PAC controller",
  "main": "desktop/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win",
    "test:pac": "node desktop/pac-test.mjs",
    "test:chrome": "node desktop/chrome-pac-test.mjs"
    ,"test:exe": "node tools/qa/exe-pac-e2e.mjs"
    ,"test:settings": "node tools/verify-settings.mjs"
  },
  "build": {
    "appId": "local.proxypilot.desktop",
    "productName": "ProxyPilot",
    "files": ["desktop/**/*", "src/**/*", "icons/**/*", "package.json"],
    "win": { "target": "nsis", "signAndEditExecutable": false }
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  }
}

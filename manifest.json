{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "src/popup/popup.html",
      "default_title": "ProxyPilot"
   },
   "background": {
      "service_worker": "src/background/background.js",
      "type": "module"
   },
   "commands": {
      "_execute_action": {
         "description": "打开代理切换菜单",
         "suggested_key": {
            "default": "Alt+Shift+P"
         }
      }
   },
   "description": "优雅高效的浏览器代理切换工具：一键切换情景模式，支持固定代理、PAC 脚本与自动切换规则。",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "111",
   "name": "ProxyPilot · 代理切换",
   "options_ui": {
      "open_in_tab": true,
      "page": "src/options/options.html"
   },
   "permissions": [ "proxy", "storage", "tabs", "webRequest", "webRequestAuthProvider" ],
   "short_name": "ProxyPilot",
   "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx",
   "version": "1.0.0"
}
